# --- Telegram API (one key pair drives ALL numbers) ---
# Get yours from https://my.telegram.org/apps
API_ID=
API_HASH=

# --- Central control bot (create via @BotFather, copy token) ---
CONTROL_BOT_TOKEN=
# Your Telegram numeric user id (talk to @userinfobot to get it).
# ONLY this id can use the control bot. Everyone else is ignored.
OWNER_ID=

# --- Storage (portable, works on Windows + Termux) ---
DB_PATH=data/central.db
SESSIONS_DIR=sessions

# --- Safety defaults ---
# No daily cap on joins (post cap stays to protect the account).
POST_DAILY_CAP=100
LOG_LEVEL=INFO
