# --- Telegram API (placeholders only - never commit real values) ---
# Get yours from https://my.telegram.org/apps
API_ID=
API_HASH=

# Optional: phone in international format, e.g. +2010xxxxxxx
# If empty, the app will ask you on first launch.
PHONE=

# --- Session & database (portable paths, no Windows hardcoded paths) ---
SESSION_NAME=userbot_session
DB_PATH=data/userbot.db

# --- Safety defaults (Phase 1: collection only, no join / no campaigns) ---
# DRY_RUN=true means: extract + save to DB, but NEVER send to Telegram.
DRY_RUN=true
# To enable real Saved Messages notifications you must set BOTH:
#   DRY_RUN=false
#   ALLOW_LIVE_SEND=true
ALLOW_LIVE_SEND=false

# Master switch for link collection (true/false)
COLLECT_ENABLED=true
# Duplicate handling: false = notify once per unique link (default).
# true would re-notify on every repeat (noisy, not recommended).
DUPLICATE_NOTIFY=false

# Phase 2: minimum seconds between join attempts (safety pacing, not a
# guarantee against restrictions). Each !tg confirm_join = one attempt max.
JOIN_COOLDOWN_SECONDS=60

LOG_LEVEL=INFO
